pipeline {
    agent any

    environment {
        PIO = "C:\\Users\\rajes\\.platformio\\penv\\Scripts\\platformio.exe"
        BOARD = "esp32dev"
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                git branch: 'master', url: 'https://github.com/rajesh19071998/PlatformIO_Jenkins_test.git'
            }
        }

        stage('PlatformIO Version') {
            steps {
                bat "\"${PIO}\" --version"
            }
        }

        stage('Build Firmware') {
            steps {
                bat "\"${PIO}\" run -e ${BOARD}"
            }
        }

        stage('Archive Firmware') {
            steps {
                archiveArtifacts artifacts: ".pio\\build\\${BOARD}\\*.bin, .pio\\build\\${BOARD}\\*.map, .pio\\build\\${BOARD}\\*.elf", fingerprint: true
            }
        }

        stage('Test') {
            steps {
                echo 'Test stage placeholder'
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished'
        }
    }
}
