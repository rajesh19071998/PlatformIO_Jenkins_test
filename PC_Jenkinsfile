pipeline {
    agent any

    environment {
        // Point directly to your PlatformIO executable
        PIO = "C:\\Users\\rajes\\.platformio\\penv\\Scripts\\platformio.exe"
        BOARD = "esp32dev"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master', url: 'https://github.com/rajesh19071998/PlatformIO_Jenkins_test.git'
            }
        }

        stage('PlatformIO Version') {
            steps {
                bat "\"${PIO}\" --version"
            }
        }

        stage('Build Firmware') {
            steps {
                bat "\"${PIO}\" run -e ${BOARD}"
            }
        }

        stage('Archive Firmware') {
            steps {
                archiveArtifacts artifacts: ".pio\\build\\${BOARD}\\firmware.bin", fingerprint: true
            }
        }

        stage('Test') {
            steps {
                //bat "\"${PIO}\" test -e ${BOARD}"
				echo 'Test'
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
